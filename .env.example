# ========================================================
# CardioLens AI Environment Configuration
# ========================================================

# Application Settings
PROJECT_NAME="CardioLens AI"
VERSION="1.0.0"
DEMO_MODE=true

# Database Connectivity
# Local Development (SQLite): sqlite:///./cardiolens.db
# Production / Docker: postgresql://cardiolens_user:password@localhost:5432/cardiolens_db
DATABASE_URL=sqlite:///./cardiolens.db

# Security & Session Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-7824021487
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google Gemma 4 AI Inference Configuration (Optional)
# Leave empty for automatic high-fidelity deterministic template fallback
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL_NAME=google/gemma-4-9b-it
GEMMA_TEMPERATURE=0.2

# Simulation & Escalation Timing
EMERGENCY_TIMEOUT_SECONDS=25
NOTIFICATION_ESCALATION_DELAY_SECONDS=15
